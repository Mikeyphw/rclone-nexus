#!/system/bin/sh
set -u
MODDIR=${RNEXUS_MODULE_DIR:-/data/adb/modules/rclone_nexus}
# shellcheck disable=SC1091
. "$MODDIR/lib/common.sh" || exit 1
rnexus_init_state

ok=0
warn=0
fail=0
line() { printf '%-28s %s\n' "$1" "$2"; }
pass() { line "$1" "OK${2:+ - $2}"; ok=$((ok + 1)); }
warning() { line "$1" "WARN${2:+ - $2}"; warn=$((warn + 1)); }
failure() { line "$1" "FAIL${2:+ - $2}"; fail=$((fail + 1)); }

printf '%s\n' 'Rclone Nexus doctor'
printf '%s\n' '--------------------------------'

if [ -d "$RNEXUS_PROVIDER_MODULE_DIR" ]; then
  pass 'provider module' "$RNEXUS_PROVIDER_MODULE_DIR"
else
  failure 'provider module' "missing module id rclone"
fi

rclone=$(rnexus_rclone_bin 2>/dev/null || true)
if [ -n "$rclone" ]; then
  version=$($rclone version 2>/dev/null | sed -n '1p' || true)
  pass 'rclone binary' "${version:-$rclone}"
else
  failure 'rclone binary' 'not found'
fi

config=$(rnexus_rclone_config)
if [ -f "$config" ]; then
  pass 'rclone config' "$config"
else
  failure 'rclone config' "$config missing"
fi

if [ -c /dev/fuse ]; then
  pass '/dev/fuse' 'character device present'
elif [ -e /dev/fuse ]; then
  warning '/dev/fuse' 'present but not a character device'
else
  failure '/dev/fuse' 'missing'
fi

if [ -d "$RNEXUS_STATE_DIR" ] && [ -w "$RNEXUS_STATE_DIR" ]; then
  pass 'persistent state' "$RNEXUS_STATE_DIR"
else
  failure 'persistent state' 'not writable'
fi

if command -v magisk >/dev/null 2>&1; then
  pass 'root framework' 'Magisk command detected'
elif [ -d /data/adb/ksu ]; then
  pass 'root framework' 'KernelSU state detected'
elif [ -d /data/adb/ap ]; then
  pass 'root framework' 'APatch state detected'
else
  warning 'root framework' 'could not identify framework'
fi

mount_count=0
for f in "$RNEXUS_MOUNTS_DIR"/*.conf; do
  [ -f "$f" ] || continue
  mount_count=$((mount_count + 1))
done
pass 'mount definitions' "$mount_count configured"

printf '\nSummary: %s OK, %s warnings, %s failures\n' "$ok" "$warn" "$fail"
[ "$fail" -eq 0 ]
