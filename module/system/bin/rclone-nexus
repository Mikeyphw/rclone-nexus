#!/system/bin/sh
set -u
MODDIR=${RNEXUS_MODULE_DIR:-/data/adb/modules/rclone_nexus}
# shellcheck disable=SC1091
. "$MODDIR/lib/common.sh" || exit 1

if [ "${1:-}" = doctor ]; then
  shift
  exec "$MODDIR/system/bin/rclone-doctor" "$@"
fi

racctl=$(rnexus_racctl_bin) || exit 1
exec "$racctl" compat nexus "$@"
